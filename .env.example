# Is file ko copy karo:  Copy-Item .env.example .env
# .env commit nahi hoti. Nayi setting add karo to yahan bhi likho.

# --- Database (docker-compose wala PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://mailonix:mailonix@localhost:5432/mailonix

# --- Gateway ---
SMTP_LISTEN_HOST=127.0.0.1
SMTP_LISTEN_PORT=2525
# Har check ka timeout (pehla andaza; SRS NFR-1 ka target poore scan ka p95 10 s)
SCAN_TIMEOUT_SECONDS=10
# Raw .eml aur attachments yahan save honge (git mein nahi)
DATA_DIR=./data

# Lab mode: replay script XCLIENT se connecting_ip/helo bata sakti hai.
# Sirf 127.0.0.1 se aur sirf jab yeh true ho. Production mein hamesha false.
LAB_TRUST_XCLIENT=true

# --- Adapters ---
TI_MODE=mock
DELIVERY=mailpit
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
